# Environment for ONE school's container. The deploy worker writes this file
# (root-only) from that school's secrets and passes it to `docker run --env-file`.
# Every value here is read when the container starts. The same image serves
# every school; only this file differs.

# This school's Supabase project (its own account).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# This school's own Paystack account (for the fees parents pay the school).
PAYSTACK_PUBLIC_KEY=pk_live_xxx
PAYSTACK_SECRET_KEY=sk_live_xxx

# This school's own Cloudflare R2 bucket for uploaded files (homework
# submissions, topic resources, student photos). One private bucket; the app
# keeps a folder per kind of file inside it. Use an access key limited to this
# one bucket (Object Read & Write). R2_ENDPOINT is the account endpoint from the
# R2 dashboard, WITHOUT the bucket name: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your-school-bucket
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Optional. Read directly by the app, not validated at start-up, so a missing
# value does not fail /api/health. Bulk email throws when it is sent without
# RESEND_API_KEY. Without EMAIL_FROM_ADDRESS it falls back to Resend's shared
# test domain, which will not deliver to arbitrary recipients.
RESEND_API_KEY=re_xxx
EMAIL_FROM_ADDRESS=School Name <noreply@school-domain.example>
# Optional. Telegram bot token for "transfer claim waiting" messages to the
# bursar's chat (the chat id is set in school settings). Without it, claims
# just wait in the Payment claims queue.
TELEGRAM_BOT_TOKEN=

# Shown on the admin license page as the contact for renewals.
LICENSE_SUPPORT_EMAIL=support@your-company.example

# This school's short id (lowercase letters, digits, hyphens). A read-only
# support link is only accepted if it was issued for this exact slug.
SCHOOL_SLUG=your-school

# Signs the one-time links that open a read-only support session on this school
# (see lib/impersonation.ts). At least 32 random characters, unique to this
# school. The control plane holds the same value for this school and nothing
# else. Generate one with: openssl rand -hex 32
IMPERSONATION_SIGNING_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32

# Not set here: IMAGE_TAG is baked into the image at build time
# (docker build --build-arg IMAGE_TAG=<git commit>) and shown by /api/health.
#
# Planned, not read by the app yet (added to the validated schemas when built):
#   TELEGRAM_BOT_TOKEN
