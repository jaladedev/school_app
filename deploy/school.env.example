# Environment for ONE school's container. The deploy worker writes this file
# (root-only) from that school's secrets and passes it to `docker run --env-file`.
# Every value here is read when the container starts. The same image serves
# every school; only this file differs.

# This school's Supabase project (its own account).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# This school's own Paystack account (for the fees parents pay the school).
PAYSTACK_PUBLIC_KEY=pk_live_xxx
PAYSTACK_SECRET_KEY=sk_live_xxx

# Not set here: IMAGE_TAG is baked into the image at build time
# (docker build --build-arg IMAGE_TAG=<git commit>) and shown by /api/health.
#
# Planned, not read by the app yet (added to the validated schemas when built):
#   R2_ENDPOINT, R2_BUCKET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
#   TELEGRAM_BOT_TOKEN
#   IMPERSONATION_SIGNING_SECRET
#   SCHOOL_SLUG
